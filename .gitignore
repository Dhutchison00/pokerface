# Python virtual environment (recreated by start.bat / setup_gpu.bat; ~1.5 GB with CUDA)
.venv/
venv/

# Solver cache: solved spots, regenerated on demand (python -m preflop_hud.solver precomputes them)
data/solutions/

# Screenshots dropped in for development. Samples already committed (the ones the tests read)
# stay tracked; add a new one deliberately with `git add -f samples/<file>`.
samples/*

# GTOpen preflop chart exports (python -m preflop_hud.gtopen batch rebuilds them)
data/gtopen/*

# Python bytecode caches
__pycache__/
*.py[cod]

# Frames saved by the HUD's Record button (hand-tracker test data)
recordings/
