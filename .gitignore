# Python virtual environment (recreated by start.bat / setup_gpu.bat; ~1.5 GB with CUDA)
.venv/
venv/

# Solver cache: solved spots, regenerated on demand (python -m preflop_hud.solver precomputes them)
data/solutions/

# Screenshots, including the ones tests/test_screenshot.py reads: they show players' screen names,
# so none are tracked
samples/

# GTOpen preflop chart exports are tracked (data/gtopen/*.npz); only a half-written export isn't
data/gtopen/*.tmp.npz

# Python bytecode caches
__pycache__/
*.py[cod]

# Frames saved by the HUD's Record button (hand-tracker test data)
recordings/

# Local settings (screen region, game mode, GTOpen path): written by the HUD, different on every machine
config.json

# Reports written by validate_multiway / validate_sparse
data/validation/

# Solved turns generated for the value-net pilot (python -m preflop_hud.pilot_data)
data/pilot/
